      "note": "leaf and combo fields",
      "input": "{\"v\":1,\"M1.mask_axis\":\"hue\",\"M1.mask_mode\":\"lows\",\"M1.mask_strength\":0.5,\"M1.mask_width\":1.5,\"M1.mask_center\":-0.25,\"M1.mask_hardness\":2,\"M1.blur\":8,\"M1.spread\":-1,\"M1.contrast\":9.5,\"M1.normalize\":true,\"M10.mask_axis\":\"sharpness\",\"C3.mask_a\":\"C2\",\"C3.mask_b\":\"M10\",\"C3.operation\":\"xor\",\"C3.blur\":64,\"C3.spread\":3,\"C3.contrast\":-10,\"C3.normalize\":true}",
