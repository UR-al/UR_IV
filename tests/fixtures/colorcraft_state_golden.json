      "state": "{\"v\":1,\"II.active\":true,\"II.pass\":\"Both\",\"II.mask\":\"C2\",\"II.strength\":-0.5,\"II.start\":0.1,\"II.end\":0.9,\"II.advanced\":true,\"II.exponent\":1.5,\"II.bias\":0.25,\"II.start_off\":-0.3,\"II.end_off\":0.2,\"II.smooth\":false,\"II.exposure\":3.99,\"II.tone_compression\":-1,\"II.contrast\":0.125,\"II.clarity\":-2,\"II.sharpness\":4,\"II.temperature\":0.01,\"II.tint\":-0.01,\"II.vibrance\":0.333,\"II.saturation\":-0.999,\"II.chroma_contrast\":1.1,\"II.chroma_center\":-0.75,\"II.more_colors\":false,\"II.temp_plus_tint\":0.1,\"II.temp_minus_tint\":0.2,\"II.lab_a\":0.3,\"II.lab_b\":0.4,\"II.lab_a_plus_b\":0.5,\"II.lab_a_minus_b\":0.6,\"II.color_shift\":false,\"II.color_shift_amount\":1.25,\"II.color_shift_mode\":\"legacy\",\"II.color_shift_red\":2,\"II.color_shift_green\":-2,\"II.color_shift_blue\":0.5,\"II.color_shift_brightness\":-0.5,\"II.recenter_override\":true,\"II.recenter\":0.75,\"II.max_chroma_override\":true,\"II.max_chroma\":10,\"II.chroma_plane_override\":true,\"II.chroma_plane\":\"lab\"}",
      "paths": {
